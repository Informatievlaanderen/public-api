{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:basisregisters:schemas:feeds:wijzigingen:adres:2026-01-21",
  "title": "Adres event data (create/update/delete)",
  "type": "object",
  "additionalProperties": false,
  "required": ["objectId", "naamruimte", "versieId", "nisCodes", "attributen"],
  "properties": {
    "objectId": {
      "type": "string",
      "description": "De objectidentificator van het adres."
    },
    "naamruimte": {
      "type": "string",
      "format": "uri",
      "description": "De naamruimte waartoe dit object behoort."
    },
    "versieId": {
      "type": "string",
      "format": "date-time",
      "description": "Tijdstip van deze versie van het adres-object."
    },
    "nisCodes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{5}$"
      },
      "description": "De NIS-code(s) van de betrokken gemeente(n) op het moment van de wijziging. Bruikbaar voor client-side filtering."
    },
    "attributen": {
      "type": "array",
      "items": { "$ref": "#/$defs/attribuutChange" },
      "description": "De gewijzigde attributen met hun oude en nieuwe waarde."
    }
  },
  "$defs": {
    "attribuutChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naam", "oudeWaarde", "nieuweWaarde"],
      "properties": {
        "naam": {
          "type": "string",
          "description": "Naam van het gewijzigde attribuut."
        },
        "oudeWaarde": {
          "description": "De waarde van het attribuut vóór de wijziging. Null bij aanmaak."
        },
        "nieuweWaarde": {
          "description": "De waarde van het attribuut na de wijziging."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "naam": { "const": "status" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": {
                "type": ["null", "string"],
                "enum": [null, "https://data.vlaanderen.be/id/concept/adresstatus/voorgesteld", "https://data.vlaanderen.be/id/concept/adresstatus/afgekeurd", "https://data.vlaanderen.be/id/concept/adresstatus/inGebruik", "https://data.vlaanderen.be/id/concept/adresstatus/gehistoreerd"]
              },
              "nieuweWaarde": {
                "type": "string",
                "enum": ["https://data.vlaanderen.be/id/concept/adresstatus/voorgesteld", "https://data.vlaanderen.be/id/concept/adresstatus/afgekeurd", "https://data.vlaanderen.be/id/concept/adresstatus/inGebruik", "https://data.vlaanderen.be/id/concept/adresstatus/gehistoreerd"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "naam": { "const": "heeftStraatnaam" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": { "type": ["null", "string"] },
              "nieuweWaarde": { "type": ["string"] }
            }
          }
        },
        {
          "if": {
            "properties": { "naam": { "const": "huisnummer" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": { "type": ["null", "string"] },
              "nieuweWaarde": { "type": ["string"] }
            }
          }
        },
        {
          "if": {
            "properties": { "naam": { "const": "busnummer" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": { "type": ["null", "string"] },
              "nieuweWaarde": { "type": ["null", "string"] }
            }
          }
        },
        {
          "if": {
            "properties": { "naam": { "const": "heeftPostinfo" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": { "type": ["null", "string"] },
              "nieuweWaarde": { "type": ["null", "string"] }
            }
          }
        },
        {
          "if": {
            "properties": { "naam": { "const": "officieelToegekend" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": { "type": ["null", "boolean"] },
              "nieuweWaarde": { "type": ["boolean"] }
            }
          }
        },
        {
          "if": {
            "properties": { "naam": { "const": "positie.geometrie" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": {
                "oneOf": [
                  { "type": "null" },
                  { "$ref": "#/$defs/adresPositie" }
                ]
              },
              "nieuweWaarde": {
                "$ref": "#/$defs/adresPositie"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "naam": { "const": "positie.methode" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": {
                "type": ["null", "string"],
                "enum": [null, "https://data.vlaanderen.be/id/concept/geometriemethode/aangeduidDoorBeheerder", "https://data.vlaanderen.be/id/concept/geometriemethode/afgeleidVanObject", "https://data.vlaanderen.be/id/concept/geometriemethode/geinterpoleerd"]
              },
              "nieuweWaarde": {
                "type": "string",
                "enum": ["https://data.vlaanderen.be/id/concept/geometriemethode/aangeduidDoorBeheerder", "https://data.vlaanderen.be/id/concept/geometriemethode/afgeleidVanObject", "https://data.vlaanderen.be/id/concept/geometriemethode/geinterpoleerd"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "naam": { "const": "positie.specificatie" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": {
                "type": ["null", "string"],
                "enum": [null, "https://data.vlaanderen.be/id/concept/geometriespecificatie/gemeente", "https://data.vlaanderen.be/id/concept/geometriespecificatie/straat", "https://data.vlaanderen.be/id/concept/geometriespecificatie/perceel", "https://data.vlaanderen.be/id/concept/geometriespecificatie/lot", "https://data.vlaanderen.be/id/concept/geometriespecificatie/standplaats", "https://data.vlaanderen.be/id/concept/geometriespecificatie/ligplaats", "https://data.vlaanderen.be/id/concept/geometriespecificatie/gebouw", "https://data.vlaanderen.be/id/concept/geometriespecificatie/gebouweenheid", "https://data.vlaanderen.be/id/concept/geometriespecificatie/ingang", "https://data.vlaanderen.be/id/concept/geometriespecificatie/wegsegment"]
              },
              "nieuweWaarde": {
                "type": "string",
                "enum": ["https://data.vlaanderen.be/id/concept/geometriespecificatie/gemeente", "https://data.vlaanderen.be/id/concept/geometriespecificatie/straat", "https://data.vlaanderen.be/id/concept/geometriespecificatie/perceel", "https://data.vlaanderen.be/id/concept/geometriespecificatie/lot", "https://data.vlaanderen.be/id/concept/geometriespecificatie/standplaats", "https://data.vlaanderen.be/id/concept/geometriespecificatie/ligplaats", "https://data.vlaanderen.be/id/concept/geometriespecificatie/gebouw", "https://data.vlaanderen.be/id/concept/geometriespecificatie/gebouweenheid", "https://data.vlaanderen.be/id/concept/geometriespecificatie/ingang", "https://data.vlaanderen.be/id/concept/geometriespecificatie/wegsegment"]
              }
            }
          }
        }
      ]
    },
    "adresPositie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "gml"],
      "properties": {
        "type": {
          "type": "string",
          "const": "Punt",
          "description": "Het type geometrie."
        },
        "gml": {
          "type": "string",
          "description": "De positie als GML-geometrie."
        }
      }
    }
  }
}
