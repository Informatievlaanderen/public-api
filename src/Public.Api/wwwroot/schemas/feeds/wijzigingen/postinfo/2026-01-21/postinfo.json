{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:basisregisters:schemas:feeds:wijzigingen:postinfo:2026-01-21",
  "title": "Postinfo event data (create/update/delete)",
  "type": "object",
  "additionalProperties": false,
  "required": ["objectId", "naamruimte", "versieId", "nisCodes", "attributen"],
  "properties": {
    "objectId": {
      "type": "string",
      "description": "De objectidentificator van de postinfo."
    },
    "naamruimte": {
      "type": "string",
      "format": "uri",
      "description": "De naamruimte waartoe dit object behoort."
    },
    "versieId": {
      "type": "string",
      "format": "date-time",
      "description": "Tijdstip van deze versie van het postinfo-object."
    },
    "nisCodes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{5}$"
      },
      "description": "De NIS-code(s) van de betrokken gemeente(n) op het moment van de wijziging. Bruikbaar voor client-side filtering."
    },
    "attributen": {
      "type": "array",
      "items": { "$ref": "#/$defs/attribuutChange" },
      "description": "De gewijzigde attributen met hun oude en nieuwe waarde."
    }
  },
  "$defs": {
    "attribuutChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naam", "oudeWaarde", "nieuweWaarde"],
      "properties": {
        "naam": {
          "type": "string",
          "description": "Naam van het gewijzigde attribuut."
        },
        "oudeWaarde": {
          "description": "De waarde van het attribuut vóór de wijziging. Null bij aanmaak."
        },
        "nieuweWaarde": {
          "description": "De waarde van het attribuut na de wijziging."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "naam": { "const": "status" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": {
                "type": ["null", "string"],
                "enum": [null, "https://data.vlaanderen.be/id/concept/postinfostatus/gerealiseerd", "https://data.vlaanderen.be/id/concept/postinfostatus/gehistoreerd"]
              },
              "nieuweWaarde": {
                "type": "string",
                "enum": ["https://data.vlaanderen.be/id/concept/postinfostatus/gerealiseerd", "https://data.vlaanderen.be/id/concept/postinfostatus/gehistoreerd"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "naam": { "const": "postnaam" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": {
                "type": "array",
                "items": { "$ref": "#/$defs/postnaamItem" }
              },
              "nieuweWaarde": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/postnaamItem" }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "naam": { "const": "isToegekendAan" } },
            "required": ["naam"]
          },
          "then": {
            "properties": {
              "oudeWaarde": { "type": ["null", "string"] },
              "nieuweWaarde": { "type": ["null", "string"] }
            }
          }
        }
      ]
    },
    "postnaamItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@value", "@language"],
      "properties": {
        "@value": { "type": "string" },
        "@language": { "type": "string", "pattern": "^[a-z]{2}$" }
      }
    }
  }
}
